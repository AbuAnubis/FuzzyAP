FUNCTION_BLOCK

VAR_INPUT
speed : REAL;
alt_delta : REAL;
ground : REAL;
END_VAR

VAR_OUTPUT
pitch_delta : REAL;
END_VAR

FUZZIFY speed
TERM stall := (0, 1) (30, 1) (50, 0);
TERM slow := (30, 0) (50, 1) (70, 1) (90, 0);
TERM normal := (70, 0) (90, 1) (110, 1) (130, 0);
TERM fast := (110, 0) (130, 1) (150, 1) (170, 0);
TERM overspeed := (150, 0) (170, 1) (200, 1);
END_FUZZIFY

FUZZIFY alt_delta
TERM exp_up := (-200, 1) (-100, 1) (-50, 0);
TERM mild_up := (-100, 0) (-50, 1) (-20, 1) (-10, 0);
TERM equal := (-20, 0) (-10, 1) (10, 1) (20, 0);
TERM mild_down := (10, 0) (20, 1) (50, 1) (100, 0);
TERM exp_down := (50, 0) (100, 1) (200, 1);
END_FUZZIFY

FUZZIFY ground
TERM terrain := (0, 1) (10, 1) (30, 0);
TERM warning := (10, 0) (30, 1) (50, 0);
TERM clear := (30, 0) (50, 1) (100, 1);
END_FUZZIFY

DEFUZZIFY pitch_delta
TERM neutral := (-10,0) (0, 1) (10, 0);
END_DEFUZZIFY

RULEBLOCK
END_RULEBLOCK

END_FUNCTION_BLOCK